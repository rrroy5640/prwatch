{
  "name": "prwatch",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && node src/main.ts",
    "dev": "node --watch-path=src src/main.ts --dev",
    "build": "vite build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
